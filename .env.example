# Copy this file to `.env`. The public landing page needs no credentials;
# /admin requires ADMIN_EMAIL and ADMIN_PASSWORD below. Other settings are
# retained for the legacy database and optional integrations.

# --- Storage (Supabase Postgres) ---
# From your Supabase project: Settings -> Database -> Connection string (URI, "Session" mode).
# Leave blank to use a local db.json file instead (fine for quick testing, not for real use).
DATABASE_URL=

# --- Email verification (villanova.edu signup codes) ---
# Any SMTP account works. Easiest: a Gmail account with an "app password"
# (myaccount.google.com/apppasswords), or a free-tier provider like SendGrid/Mailgun.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Texting & calling the orderer (Twilio) ---
# Sign up at twilio.com — free trial credit, then a phone number is ~$1/month.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Payments (Stripe) ---
# Runners connect a payout account (Stripe Connect Express); orderers pay a
# delivery fee by card at order time, charged + split 75/25 the moment a
# runner claims it. Leave blank to skip payments entirely (orders/claims
# just work with no charge). Get test-mode keys at dashboard.stripe.com ->
# toggle "Test mode" -> Developers -> API keys. Also enable Connect there
# (Connect -> Get started -> "Platform or marketplace").
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Admin credentials for /admin. These do not need a web-app account.
# Both settings are required; leave either blank to disable admin sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Server-only Supabase access for /admin native account test credits.
# Use the same Supabase project as ios/App/App/NativeApp.swift. Prefer a
# current sb_secret_ key; a legacy service_role key also works. Never put
# either secret in the Swift app, public files, or a client-side env variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Live runner location (Mapbox) ---
# Free account at mapbox.com -> Account -> Access tokens -> default public
# token (starts with pk.). Leave blank to skip the live map entirely.
MAPBOX_TOKEN=

# --- AI-assisted delivery pricing (Anthropic) ---
# Lets the pricing popup use a real Claude call to reason about the
# recommended delivery fee (within fixed rules — the 75/25 split, the
# $10/hour wage floor, and the $2.50-$12 bounds are never up to the model).
# Leave blank to skip it — pricing still works, just from the deterministic
# formula alone (pricing.js) with no AI call. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional — defaults to Haiku 4.5, which is fast/cheap and plenty for this.
PRICING_AI_MODEL=claude-haiku-4-5-20251001

# --- Push notifications (Web Push) ---
# Lets NovaDash send a real OS-level notification (even with the app
# closed) when someone gets a new message. Generate a keypair with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to skip it — the in-app unread badge still works either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Session cookie secret — set this to something random before deploying anywhere public.
SESSION_SECRET=wildcat-eats-dev-secret-change-me

PORT=3000
